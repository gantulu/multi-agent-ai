{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gantulu/multi-agent-ai/blob/main/schemas/agent.schema.json",
  "title": "Agent Metadata",
  "description": "Metadata contract for one discoverable AI Agent.",
  "type": "object",
  "required": ["id", "name", "description", "path", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "pattern": "^agents/[a-z0-9-]+/README\\.md$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    },
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "keywords": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "workflows": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
